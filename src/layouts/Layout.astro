---
import Analytics from '@vercel/analytics/astro'
import { basics } from "@cv"
import DarkModeToggle from "@/components/DarkModeToggle.astro"

interface Props {
  title: string
}

const { title } = Astro.props

const { image, summary, url } = basics
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <Analytics mode="auto"/>
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href={image} />

    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content="" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ''} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content="" />
  </head>
  <body>
    <DarkModeToggle />
    <slot />
    <script>
      import { initFaro } from '../utils/faro';
      initFaro();
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: var(--paper);
    color: var(--ink);
    letter-spacing: -0.025rem;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  p {
    color: var(--ink-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  .cv-page-break {
    display: none;
  }

  @page {
    size: letter;
    margin: 12mm 14mm;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }

    /* La impresión/PDF siempre usa el tema claro, nunca modo oscuro */
    html:root,
    html:root.dark {
      --paper: #fafafa;
      --paper-elevated: #fff;
      --ink: #1a1a1a;
      --ink-secondary: #444;
      --ink-tertiary: #5c5c5c;
      --ink-muted: #737373;
      --line: rgba(0, 0, 0, 0.08);
      --line-subtle: rgba(0, 0, 0, 0.05);
      --accent: #2563eb;
      --accent-hover: #1d4ed8;
      --shadow: 0 1px 3px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    /* Ocultar el cursor de la animación de tipeo en el PDF */
    .typing-cursor {
      display: none !important;
    }

    /* Modo "Versión CV": layout compacto distribuido en 3 páginas */
    html.printing-cv * {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    html.printing-cv main {
      padding: 0;
    }

    html.printing-cv section {
      margin-bottom: calc(var(--space-unit, 8px) * 3.5);
    }

    html.printing-cv .cv-page-break {
      display: block;
      break-before: page;
    }
  }
</style>
