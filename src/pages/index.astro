---
import Layout from "@/layouts/Layout.astro"
import SpeedInsights from "@vercel/speed-insights/astro"

import About from "@/components/sections/About.astro"
import Education from "@/components/sections/Education.astro"
import Experience from "@/components/sections/Experience.astro"
import Hero from "@/components/sections/Hero.astro"
import Projects from "@/components/sections/Projects.astro"
import Skills from "@/components/sections/Skills.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"
import FlipScene from "@/components/FlipScene.astro"
import HumanHero from "@/components/sections/human/HumanHero.astro"
import HumanTimeline from "@/components/sections/human/HumanTimeline.astro"

import { basics } from "@cv"
const { name, label } = basics
---

<Layout title={`Portafolio de ${name} - ${label}`}>
  <FlipScene>
    <main slot="front">
      <Hero />
      <About />
      <Experience />
      <div class="cv-page-break" aria-hidden="true"></div>
      <Education />
      <Projects />
      <Skills />
    </main>

    <main slot="back" class="human-main">
      <HumanHero />
      <HumanTimeline />
    </main>
  </FlipScene>

  <KeyboardManager />
</Layout>

<SpeedInsights />
<style>
  main {
    padding: calc(var(--space-unit, 8px) * 4);
    margin: 0 auto;
    width: 100%;
    max-width: 720px;
  }

  @media (width <= 700px) {
    main {
      padding: calc(var(--space-unit, 8px) * 3);
    }
  }
</style>
